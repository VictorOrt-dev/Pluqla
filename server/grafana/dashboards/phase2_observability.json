{
  "uid": "phase2_observability",
  "title": "Phase 2 Observability Dashboard",
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "options": [
          {"text": "Production", "value": "production"},
          {"text": "Staging", "value": "staging"},
          {"text": "Development", "value": "development"}
        ],
        "current": {"text": "Production", "value": "production"}
      },
      {
        "name": "service",
        "type": "custom",
        "options": [
          {"text": "API", "value": "api"},
          {"text": "Worker", "value": "worker"}
        ],
        "current": {"text": "API", "value": "api"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "P95 Latency by Route",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"api\"}[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ],
      "yaxes": [{"format": "s", "label": "Latency"}]
    },
    {
      "id": 2,
      "title": "Request Rate (req/s) by Route",
      "type": "graph",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"api\"}[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "yaxes": [{"format": "reqps", "label": "Requests/sec"}]
    },
    {
      "id": 3,
      "title": "Error Rate %",
      "type": "graph",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"api\",status=~\"4..|5..\"}[5m])) / sum(rate(http_requests_total{job=\"api\"}[5m])) * 100",
          "legendFormat": "Error Rate %"
        }
      ],
      "yaxes": [{"format": "percent", "label": "Error %"}]
    },
    {
      "id": 4,
      "title": "AI Cost per Minute (cents)",
      "type": "graph",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(ai_cost_cents_total[1m]) * 60",
          "legendFormat": "Cost/min"
        }
      ],
      "yaxes": [{"format": "currencyUSD", "label": "Cents/min"}]
    },
    {
      "id": 5,
      "title": "Cumulative AI Cost",
      "type": "graph",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "ai_cost_cents_total",
          "legendFormat": "Total Cost (cents)"
        }
      ],
      "yaxes": [{"format": "currencyUSD", "label": "Total Cents"}]
    },
    {
      "id": 6,
      "title": "AI Calls by Model",
      "type": "graph",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(ai_calls_total[5m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ],
      "yaxes": [{"format": "ops", "label": "Calls/sec"}]
    }
  ]
}
