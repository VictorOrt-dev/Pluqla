# Node environment
NODE_ENV=development
PORT=3004

# Observability
METRICS_ENABLED=true
METRICS_SCRAPE_PATH=/metrics
METRICS_AUTH_TOKEN=secret_prom_token
REDIRECT_LOGS=true
LOG_LEVEL=info

# AI Cost estimation (cents per call)
AI_COST_PER_CALL_OPENAI=0.5
AI_COST_PER_CALL_ANTHROPIC=1.0

# Database (example)
DATABASE_URL=postgresql://user:pass@localhost:5432/pluqla

# Healthcheck dependencies
DB_HEALTHCHECK_ENABLED=true
CACHE_HEALTHCHECK_ENABLED=true
AI_HEALTHCHECK_ENABLED=false

# Nordigen/GoCardless Bank Account Data API
# Get your free API keys at: https://bankaccountdata.gocardless.com/
NORDIGEN_SECRET_ID=your_secret_id_here
NORDIGEN_SECRET_KEY=your_secret_key_here
NORDIGEN_REDIRECT_URL=http://localhost:3000/finance/bank-callback
