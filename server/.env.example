# Node environment
NODE_ENV=development
PORT=3004

# Observability
METRICS_ENABLED=true
METRICS_SCRAPE_PATH=/metrics
METRICS_AUTH_TOKEN=secret_prom_token
REDIRECT_LOGS=true
LOG_LEVEL=info

# ✨ Phase 1B - Observability & Monitoring
PROMETHEUS_METRICS_ENABLED=true
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.1

# AI Cost estimation (cents per call)
AI_COST_PER_CALL_OPENAI=0.5
AI_COST_PER_CALL_ANTHROPIC=1.0

# Database (example)
DATABASE_URL=postgresql://user:pass@localhost:5432/pluqla

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Worker Configuration
WORKER_HTTP_PORT=3005

# =================================
# RECIPE API PROVIDERS
# =================================

# Spoonacular API (Primary provider - 150 req/day free tier)
# Get your API key at: https://spoonacular.com/food-api/console#Dashboard
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Edamam Recipe API (Fallback provider - 10,000 req/month free tier)
# Get your credentials at: https://developer.edamam.com/
EDAMAM_APP_ID=your_edamam_app_id_here
EDAMAM_APP_KEY=your_edamam_app_key_here

# TheMealDB API (Free unlimited - used as final fallback / offline mode)
# No API key required for free tier

# ✨ Phase 1B - Security & IP Deduplication
# IP Hashing Salt (generate unique per environment using: openssl rand -hex 32)
IP_SALT=your_random_salt_here_change_in_production

# Rate Limiting Configuration
RATE_LIMITING_ENABLED=true

# Fraud Detection Configuration
FRAUD_DETECTION_ENABLED=true
FRAUD_DETECTION_THRESHOLD=70
FRAUD_DETECTION_BLOCK_THRESHOLD=90

# GDPR Compliance
GDPR_EXPORT_ENABLED=true
GDPR_DELETE_ENABLED=true

# Healthcheck dependencies
DB_HEALTHCHECK_ENABLED=true
CACHE_HEALTHCHECK_ENABLED=true
AI_HEALTHCHECK_ENABLED=false

# Nordigen/GoCardless Bank Account Data API
# Get your free API keys at: https://bankaccountdata.gocardless.com/
NORDIGEN_SECRET_ID=your_secret_id_here
NORDIGEN_SECRET_KEY=your_secret_key_here
NORDIGEN_REDIRECT_URL=http://localhost:3000/finance/bank-callback
