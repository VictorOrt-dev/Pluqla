# 🚀 PLUQLA BACKEND CONFIGURATION
# Copy this file to .env and fill in your actual values

# ===== CORE SETTINGS =====
NODE_ENV=development
PORT=3004

# ===== DATABASE CONFIGURATION =====
# For development: SQLite database (auto-created if doesn't exist)
# For production: PostgreSQL connection string
DATABASE_URL="file:./dev.db"
# Alternative PostgreSQL format:
# DATABASE_URL="postgresql://username:password@localhost:5432/pluqla_dev"

# Database connection settings
DB_CONNECTION_LIMIT=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10
DB_APP_NAME=pluqla-backend

# ===== JWT SECRETS (CRITICAL - GENERATE YOUR OWN) =====
# Generate secure secrets using: openssl rand -base64 32
# NEVER use these example values in production!
JWT_SECRET="your-super-secure-jwt-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="your-super-secure-refresh-secret-at-least-32-characters"
JWT_EMAIL_SECRET="your-super-secure-email-secret-at-least-32-characters"
JWT_PASSWORD_RESET_SECRET="your-super-secure-reset-secret-at-least-32-characters"

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_EXPIRES_IN=24h
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ===== CORS CONFIGURATION =====
# Allowed origins for CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"
TRUST_PROXY=false

# ===== FILE UPLOAD SETTINGS =====
UPLOAD_MAX_SIZE=10mb
UPLOAD_DIR=uploads

# ===== EMAIL CONFIGURATION =====
# Set to true to enable email features
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@pluqla.com"

# ===== REDIS CONFIGURATION (Optional) =====
# Leave empty to use in-memory cache
# Format: redis://localhost:6379 or redis://user:pass@host:port
REDIS_URL=""

# ===== AI SERVICES =====
# OpenAI API Key
OPENAI_API_KEY=""
OPENAI_ORG_ID=""

# Anthropic Claude API Key
ANTHROPIC_API_KEY=""

# Google Gemini API Key
GOOGLE_AI_API_KEY=""

# ===== PAYMENT SERVICES =====
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE=sandbox

# ===== SOCIAL AUTH SECRETS =====
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===== EXTERNAL SERVICES =====
# Sentry for error monitoring
SENTRY_DSN=""

# Analytics
GOOGLE_ANALYTICS_SECRET=""

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== SECURITY =====
# Session secret
SESSION_SECRET="your-super-secure-session-secret-at-least-32-characters"

# Encryption key for sensitive data
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# ===== DEVELOPMENT FLAGS =====
DEBUG_SQL=false
ENABLE_API_DOCS=true
MOCK_EXTERNAL_APIS=false

# ===== WEBHOOK ENDPOINTS =====
# For payment processing, notifications, etc.
WEBHOOK_SECRET=""

# ===== CACHE CONFIGURATION =====
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# ===== FILE STORAGE =====
# Local storage path
STORAGE_PATH=./storage

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=us-east-1
AWS_S3_BUCKET=""

# ===== API RATE LIMITS =====
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX=100

# ===== NOTIFICATION SERVICES =====
# Push notifications
FCM_SERVER_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ===== MONITORING =====
# Health check configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true