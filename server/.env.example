# 🚀 PLUQLA BACKEND CONFIGURATION
# Copy this file to .env and fill in your actual values

# ===== CORE SETTINGS =====
NODE_ENV=development
PORT=3004

# ===== DATABASE CONFIGURATION =====
# PostgreSQL connection string (REQUIRED for production)
DATABASE_URL="postgresql://pluqla_user:secure_password_here@localhost:5432/pluqla_production"
# For development:
# DATABASE_URL="postgresql://pluqla_user:dev_password@localhost:5432/pluqla_dev"

# Database connection settings
DB_CONNECTION_LIMIT=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10
DB_APP_NAME=pluqla-backend

# ===== JWT SECRETS (CRITICAL - GENERATE YOUR OWN) =====
# SECURITY WARNING: Generate secure secrets using: openssl rand -hex 32 (64 chars)
# OR use: openssl rand -base64 32 (44+ chars)
# NEVER use these example values in production!
# Each secret must be at least 32 characters long for security
JWT_SECRET="862b02abd32adc3d9106d24ae2b9288518957468d9ce4513cae8e72aaf9b99f3"
JWT_REFRESH_SECRET="39c2c5581e92f6518824dd71ad52b5aff437edf0f8899b706d697a062f87f713"
JWT_EMAIL_SECRET="cd0d1761f682e3a0bb67e1a963f4791fd14dfa1596513e60431165148cec5444"
JWT_PASSWORD_RESET_SECRET="4f8a2b3c5d6e7f8g9h0i1j2k3l4m5n6o7p8q9r0s1t2u3v4w5x6y7z8a9b0c1d2e"

# ===== BETTER AUTH CONFIGURATION =====
# Better Auth secret key (CRITICAL - Generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8"
# Base URL for Better Auth callbacks and redirects
BASE_URL="http://localhost:3004"

# Session Configuration (Better Auth Cookies)
# Session expiration time in seconds (default: 604800 = 7 days)
SESSION_EXPIRES_IN=604800
# Session update age in seconds (how often to update session timestamp, default: 3600 = 1 hour)
SESSION_UPDATE_AGE=3600
# Cookie domain (leave empty for localhost, set to your domain in production)
COOKIE_DOMAIN=""

# Session Cleanup Configuration
# Enable automatic session cleanup (default: true)
SESSION_CLEANUP_ENABLED=true
# Cron schedule for session cleanup (default: "0 3 * * *" = 3 AM daily)
# Format: "minute hour day month weekday"
# Examples:
#   "0 3 * * *"   = Every day at 3:00 AM
#   "*/30 * * * *" = Every 30 minutes
#   "0 */6 * * *" = Every 6 hours
SESSION_CLEANUP_CRON="0 3 * * *"
# Run cleanup on server startup (default: false)
SESSION_CLEANUP_ON_STARTUP=false

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_EXPIRES_IN=24h
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ===== CORS CONFIGURATION =====
# Allowed origins for CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"
TRUST_PROXY=false

# ===== FILE UPLOAD SETTINGS =====
UPLOAD_MAX_SIZE=10mb
UPLOAD_DIR=uploads

# ===== EMAIL CONFIGURATION =====
# Set to true to enable email features
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@pluqla.com"

# ===== REDIS CONFIGURATION (Optional) =====
# Leave empty to use in-memory cache
# Format: redis://localhost:6379 or redis://user:pass@host:port
REDIS_URL=""

# ===== AI SERVICES CONFIGURATION =====
# AI Provider Selection (REQUIRED)
# Options: none | openai | anthropic | mistral | azure
# Set to "none" to disable all AI features
AI_PROVIDER=none

# AI API Configuration
AI_API_KEY=""
AI_MODEL=""

# Provider-Specific Settings
# OpenAI
OPENAI_API_KEY=""
OPENAI_ORG_ID=""

# Anthropic Claude
ANTHROPIC_API_KEY=""

# Mistral AI
MISTRAL_API_KEY=""

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# Google Gemini API Key
GOOGLE_AI_API_KEY=""

# AI Safety & Rate Limiting
AI_MAX_TOKENS=4000
AI_MAX_RETRIES=3
AI_TIMEOUT=30000
AI_MAX_REQUEST_SIZE=1048576
AI_MAX_COST_PER_REQUEST=1.0
AI_MAX_DAILY_COST_PER_USER=50.0
AI_MAX_MONTHLY_COST=5000.0

# AI Data Anonymization
AI_ANONYMIZATION_SALT="pluqla-ai-anonymization-2024"

# Default User Tier for Rate Limiting
DEFAULT_USER_TIER=free

# ===== PAYMENT SERVICES =====
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE=sandbox

# ===== SOCIAL AUTH SECRETS =====
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===== EXTERNAL SERVICES =====
# Sentry for error monitoring
SENTRY_DSN=""

# Analytics
GOOGLE_ANALYTICS_SECRET=""

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== SECURITY =====
# Session secret
SESSION_SECRET="your-super-secure-session-secret-at-least-32-characters"

# CRITICAL SECURITY KEYS (REQUIRED)
# Generate with: openssl rand -hex 32
FINANCIAL_ENCRYPTION_KEY="cd0d1761f682e3a0bb67e1a963f4791fd14dfa1596513e60431165148cec5444"
BANK_ENCRYPTION_KEY="862b02abd32adc3d9106d24ae2b9288518957468d9ce4513cae8e72aaf9b99f3"

# IMPORTANT: Never use default values in production!
# These keys must be exactly 64 hexadecimal characters (32 bytes)
# Generate secure keys using: openssl rand -hex 32

# ===== AUTHENTICATION SECURITY =====
# Account Lockout Configuration (Brute-Force Prevention)
# Number of failed login attempts before account lockout (default: 5)
AUTH_MAX_ATTEMPTS=5
# Time window for counting failed attempts in milliseconds (default: 900000 = 15 minutes)
AUTH_ATTEMPT_WINDOW_MS=900000
# Duration of account lockout in milliseconds (default: 1800000 = 30 minutes)
AUTH_LOCKOUT_DURATION_MS=1800000

# Password Policy Configuration
# Password requirements are enforced server-side:
# - Minimum 10 characters
# - At least 1 uppercase letter
# - At least 1 lowercase letter
# - At least 1 digit
# - At least 1 special character
# - Not in common password list
# - No sequential or repeated characters

# ===== DEVELOPMENT FLAGS =====
DEBUG_SQL=false
ENABLE_API_DOCS=true
MOCK_EXTERNAL_APIS=false

# ===== WEBHOOK ENDPOINTS =====
# For payment processing, notifications, etc.
WEBHOOK_SECRET=""

# ===== CACHE CONFIGURATION =====
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# ===== FILE STORAGE =====
# Local storage path
STORAGE_PATH=./storage

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=us-east-1
AWS_S3_BUCKET=""

# ===== API RATE LIMITS =====
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX=100

# ===== NOTIFICATION SERVICES =====
# Push notifications
FCM_SERVER_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ===== MONITORING =====
# Health check configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true