generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                        @id @default(cuid())
  email                  String                        @unique
  password               String
  name                   String
  role                   String                        @default("user")
  status                 String                        @default("active")
  savedAmount            Float                         @default(0)
  monthlyGoal            Float                         @default(800)
  streak                 Int                           @default(0)
  lastSavingDate         DateTime?
  level                  Int                           @default(1)
  plansUsedThisMonth     Int                           @default(0)
  isPremium              Boolean                       @default(false)
  subscriptionTier       SubscriptionTier              @default(FREE)
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  gamificationPoints     Int                           @default(0)
  lastLoginAt            DateTime?
  lastScaAt              DateTime?
  emailVerified          Boolean                       @default(false)
  emailVerificationToken String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  accounts               Account[]
  aiUsageRecords         AiUsage[]
  analyticsEvents        AnalyticsEvent[]
  assets                 Asset[]
  betterAuthAccounts     BetterAuthAccount[]
  betterAuthSessions     BetterAuthSession[]
  budgetPlans            BudgetPlan[]
  cacheEntries           CacheEntry[]
  dailyChallenges        DailyChallenge[]
  dataProcessingLogs     DataProcessingLog[]
  expenses               Expense[]
  favoriteRecipes        FavoriteRecipe[]
  foodSpendingLogs       FoodSpendingLog[]
  financialGoals         FinancialGoal[]
  financialSuggestions   FinancialSuggestion[]
  incomes                Income[]
  liabilities            Liability[]
  netWorthSnapshots      NetWorthSnapshot[]
  passwordResets         PasswordReset[]
  photoMatchJobs         PhotoMatchJob[]
  photoMatchResults      PhotoMatchResult[]
  refreshTokens          RefreshToken[]
  transportOptJobs       TransportOptimizationJob[]
  transportOptResults    TransportOptimizationResult[]
  transportTrips         TransportTrip[]
  mealSuggestionJobs     MealSuggestionJob[]
  mealSuggestionResults  MealSuggestionResult[]
  mealPreferences        UserMealPreferences?
  weeklyMealPlans        WeeklyMealPlan[]
  groceryLists           GroceryList[]
  favoriteMeals          FavoriteMeal[]
  mealPlanTemplates      MealPlanTemplate[]
  sharedMealPlans        SharedMealPlan[]
  scaChallenges          ScaChallenge[]
  scaSessions            ScaSession[]
  securityIncidents      SecurityIncident[]
  transactions           Transaction[]
  answers                UserAnswer[]
  badges                 UserBadge[]
  consents               UserConsent[]
  userDevices            UserDevice[]
  userLocations          UserLocation[]
  userProfile            UserProfile?
  recipeInteractions     RecipeInteraction[]

  @@index([role], map: "idx_user_role")
  @@index([status], map: "idx_user_status")
  @@index([emailVerificationToken], map: "idx_user_email_verification_token")
  @@index([lastLoginAt], map: "idx_user_last_login")
  @@index([isPremium], map: "idx_user_premium")
  @@index([createdAt], map: "idx_user_created_at")
  @@map("users")
}

model UserAnswer {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key], map: "idx_user_answer_key")
  @@index([key, value], map: "idx_user_answer_key_value")
  @@map("user_answers")
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  category    String
  description String
  type        String   @default("saving")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_transaction_user_id")
  @@index([userId, date], map: "idx_transaction_user_date")
  @@index([userId, category], map: "idx_transaction_user_category")
  @@index([date], map: "idx_transaction_date")
  @@index([category], map: "idx_transaction_category")
  @@index([userId, category, date], map: "idx_transaction_user_category_date")
  @@map("transactions")
}

// ============================================================================
// RECIPE MODELS - API-Based (No local Recipe storage)
// ============================================================================

/// Favorite recipes from external APIs (Spoonacular, Edamam, TheMealDB)
model FavoriteRecipe {
  id              String   @id @default(cuid())
  userId          String
  externalId      String   // Recipe ID from external provider
  provider        String   // 'spoonacular', 'edamam', 'themealdb'
  recipeData      Json     // Cached recipe data (title, image, price, etc.)
  pricePerServing Float?   // Price in EUR
  ecoScore        Int?     // Pluqla EcoScore 0-100
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId], map: "idx_favorite_recipe_user")
  @@index([provider, externalId], map: "idx_favorite_recipe_external")
  @@index([userId, createdAt], map: "idx_favorite_recipe_user_created")
  @@map("favorite_recipes")
}

/// Food spending log for budget tracking
/// Phase 5: Prévision vs Réalité - Enhanced model
model FoodSpendingLog {
  id                    String    @id @default(cuid())
  userId                String
  externalId            String    // Recipe ID from provider
  provider              String    // 'spoonacular', 'edamam', 'themealdb'
  recipeName            String

  // Phase 4B - Prévision (forecast)
  costEur               Float     // Estimated cost per serving
  servings              Int       @default(1)
  totalCostEur          Float     // costEur * servings (estimated total)

  // Phase 5 - Réalité (actual)
  estimatedPriceEur     Float?    // Same as totalCostEur, kept for clarity
  actualPriceEur        Float?    // Real price from bank transaction

  // Phase 5 - Matching
  status                String    @default("forecast") // "forecast", "matched", "archived"
  linkedTransactionId   String?   // Link to AccountTransaction

  // Dates
  date                  DateTime  @default(now()) // Date planned/logged
  dateMatched           DateTime? // Date when matched with real transaction

  // Metadata
  category              String    @default("food") // For finance integration
  metadata              Json?     // Additional data (ingredients, eco-score, etc.)
  createdAt             DateTime  @default(now())

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date], map: "idx_food_spending_user_date")
  @@index([userId, category], map: "idx_food_spending_user_category")
  @@index([userId, status], map: "idx_food_spending_user_status")
  @@index([status, date], map: "idx_food_spending_status_date")
  @@index([linkedTransactionId], map: "idx_food_spending_transaction")
  @@index([date], map: "idx_food_spending_date")
  @@map("food_spending_logs")
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  title       String
  description String
  icon        String
  points      Int
  rarity      String
  requirement String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]

  @@index([isActive], map: "idx_badge_active")
  @@index([rarity], map: "idx_badge_rarity")
  @@index([points], map: "idx_badge_points")
  @@map("badges")
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId], map: "idx_user_badge_user")
  @@index([badgeId], map: "idx_user_badge_badge")
  @@index([unlockedAt], map: "idx_user_badge_unlocked")
  @@map("user_badges")
}

model DailyChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  title       String
  description String
  points      Int
  date        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, date])
  @@index([userId, date], map: "idx_daily_challenge_user_date")
  @@index([date, completed], map: "idx_daily_challenge_date_completed")
  @@index([userId, completed], map: "idx_daily_challenge_user_completed")
  @@map("daily_challenges")
}

model CacheEntry {
  id        String   @id @default(cuid())
  userId    String?
  cacheKey  String
  category  String
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cacheKey, category])
  @@index([expiresAt], map: "idx_cache_expires_at")
  @@index([category], map: "idx_cache_category")
  @@index([userId, category], map: "idx_cache_user_category")
  @@index([category, expiresAt], map: "idx_cache_category_expires")
  @@map("cache_entries")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String
  type       String
  properties String
  metadata   String
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "idx_analytics_user_type")
  @@index([sessionId], map: "idx_analytics_session")
  @@index([timestamp], map: "idx_analytics_timestamp")
  @@index([type, timestamp], map: "idx_analytics_type_timestamp")
  @@index([userId, timestamp], map: "idx_analytics_user_timestamp")
  @@map("analytics_events")
}

model FeatureFlag {
  id             String    @id @default(cuid())
  name           String    @unique
  enabled        Boolean   @default(false)
  description    String?
  targetingRules Json?     // Phase 1B: userIds, roles, isPremium, percentage rollout
  conditions     String?   // Deprecated - use targetingRules instead
  environment    String    @default("production")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([environment], map: "idx_feature_flag_environment")
  @@index([enabled], map: "idx_feature_flag_enabled")
  @@index([environment, enabled], map: "idx_feature_flag_env_enabled")
  @@index([expiresAt], map: "idx_feature_flag_expires")
  @@map("feature_flags")
}

model Image {
  id           String   @id @default(cuid())
  userId       String?
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  analyzed     Boolean  @default(false)
  analysisData String?
  createdAt    DateTime @default(now())

  @@index([userId], map: "idx_image_user")
  @@index([analyzed], map: "idx_image_analyzed")
  @@index([mimetype], map: "idx_image_mimetype")
  @@index([createdAt], map: "idx_image_created")
  @@map("images")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  jti       String    @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_token_user")
  @@index([expiresAt], map: "idx_refresh_token_expires")
  @@index([revoked], map: "idx_refresh_token_revoked")
  @@index([jti], map: "idx_refresh_token_jti")
  @@index([userId, revoked, expiresAt], map: "idx_refresh_token_user_active")
  @@index([jti, userId], map: "idx_refresh_token_jti_user")
  @@index([revoked, expiresAt], map: "idx_refresh_token_cleanup")
  @@map("refresh_tokens")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  tokenType String
  userId    String?
  expiresAt DateTime
  reason    String
  revokedBy String
  revokedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([tokenHash], map: "idx_token_blacklist_hash")
  @@index([expiresAt], map: "idx_token_blacklist_expires")
  @@index([userId], map: "idx_token_blacklist_user")
  @@index([tokenType], map: "idx_token_blacklist_type")
  @@index([tokenType, expiresAt], map: "idx_token_blacklist_type_expires")
  @@map("token_blacklist")
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_password_reset_token")
  @@index([userId], map: "idx_password_reset_user")
  @@index([expiresAt], map: "idx_password_reset_expires")
  @@index([used], map: "idx_password_reset_used")
  @@index([userId, used, expiresAt], map: "idx_password_reset_user_active")
  @@index([used, expiresAt], map: "idx_password_reset_cleanup")
  @@map("password_resets")
}

model UserConsent {
  id          String    @id @default(cuid())
  userId      String
  consentType String
  purpose     String
  legalBasis  String
  granted     Boolean
  grantedAt   DateTime?
  withdrawnAt DateTime?
  ipAddress   String?
  userAgent   String?
  version     String    @default("1.0")
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType], map: "idx_user_consent_user_type")
  @@index([createdAt], map: "idx_user_consent_created")
  @@index([granted], map: "idx_user_consent_granted")
  @@index([consentType, granted], map: "idx_user_consent_type_granted")
  @@map("user_consents")
}

model DataProcessingLog {
  id           String   @id @default(cuid())
  userId       String?
  operation    String
  dataType     String
  description  String
  legalBasis   String
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  metadata     String?
  timestamp    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_data_processing_user")
  @@index([timestamp], map: "idx_data_processing_timestamp")
  @@index([operation], map: "idx_data_processing_operation")
  @@index([dataType], map: "idx_data_processing_data_type")
  @@index([success], map: "idx_data_processing_success")
  @@index([operation, timestamp], map: "idx_data_processing_op_time")
  @@map("data_processing_logs")
}

model SecurityIncident {
  id           String    @id @default(cuid())
  userId       String?
  incidentType String
  severity     String
  description  String
  ipAddress    String?
  userAgent    String?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String?
  metadata     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_security_incident_user")
  @@index([incidentType], map: "idx_security_incident_type")
  @@index([severity], map: "idx_security_incident_severity")
  @@index([resolved], map: "idx_security_incident_resolved")
  @@index([createdAt], map: "idx_security_incident_created")
  @@index([severity, resolved], map: "idx_security_incident_severity_resolved")
  @@index([incidentType, createdAt], map: "idx_security_incident_type_created")
  @@map("security_incidents")
}

model Account {
  id                   String               @id @default(cuid())
  userId               String
  name                 String
  type                 String
  subtype              String?
  provider             String
  balance              Float                @default(0)
  currency             String               @default("EUR")
  isActive             Boolean              @default(true)
  lastSyncAt           DateTime?
  syncError            String?
  encryptedCredentials String?
  accountNumber        String?
  iban                 String?
  nordigenAccountId    String?              // Nordigen account ID
  nordigenRequisitionId String?             // Nordigen requisition ID
  nordigenInstitutionId String?             // Nordigen bank institution ID
  nordigenAccessToken   String?             // Encrypted Nordigen access token
  nordigenRefreshToken  String?             // Encrypted Nordigen refresh token
  nordigenTokenExpiry   DateTime?           // Token expiration date
  metadata             String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  accountTransactions  AccountTransaction[]
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets               Asset[]
  incomes              Income[]
  liabilities          Liability[]

  @@index([userId, type], map: "idx_account_user_type")
  @@index([provider], map: "idx_account_provider")
  @@index([isActive], map: "idx_account_active")
  @@index([userId, isActive], map: "idx_account_user_active")
  @@index([lastSyncAt], map: "idx_account_last_sync")
  @@index([nordigenAccountId], map: "idx_account_nordigen_id")
  @@index([nordigenRequisitionId], map: "idx_account_nordigen_req")
  @@map("accounts")
}

model Asset {
  id               String    @id @default(cuid())
  userId           String
  accountId        String?
  name             String
  type             String
  symbol           String?
  quantity         Float     @default(0)
  unitValue        Float
  totalValue       Float
  currency         String    @default("EUR")
  acquisitionDate  DateTime?
  acquisitionPrice Float?
  metadata         String?
  lastUpdateAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  account          Account?  @relation(fields: [accountId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "idx_asset_user_type")
  @@index([symbol], map: "idx_asset_symbol")
  @@index([type], map: "idx_asset_type")
  @@index([lastUpdateAt], map: "idx_asset_last_update")
  @@index([userId, totalValue], map: "idx_asset_user_value")
  @@map("assets")
}

model Liability {
  id             String    @id @default(cuid())
  userId         String
  accountId      String?
  name           String
  type           String
  balance        Float
  interestRate   Float?
  monthlyPayment Float?
  minimumPayment Float?
  dueDate        DateTime?
  originalAmount Float?
  currency       String    @default("EUR")
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  account        Account?  @relation(fields: [accountId], references: [id])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "idx_liability_user_type")
  @@index([dueDate], map: "idx_liability_due_date")
  @@index([userId, dueDate], map: "idx_liability_user_due")
  @@map("liabilities")
}

model Income {
  id               String    @id @default(cuid())
  userId           String
  accountId        String?
  name             String
  type             String
  amount           Float
  frequency        String
  isActive         Boolean   @default(true)
  nextExpectedDate DateTime?
  taxRate          Float?
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  account          Account?  @relation(fields: [accountId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "idx_income_user_type")
  @@index([isActive], map: "idx_income_active")
  @@index([userId, isActive], map: "idx_income_user_active")
  @@index([nextExpectedDate], map: "idx_income_next_expected")
  @@map("incomes")
}

model FinancialGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  priority      String    @default("medium")
  status        String    @default("active")
  description   String?
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status], map: "idx_financial_goal_user_status")
  @@index([type], map: "idx_financial_goal_type")
  @@index([priority], map: "idx_financial_goal_priority")
  @@index([targetDate], map: "idx_financial_goal_target_date")
  @@map("financial_goals")
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  totalAssets      Float
  totalLiabilities Float
  netWorth         Float
  liquidAssets     Float
  monthlyIncome    Float
  monthlyExpenses  Float
  savingsRate      Float?
  metadata         String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date], map: "idx_net_worth_user_date")
  @@index([date], map: "idx_net_worth_date")
  @@map("net_worth_snapshots")
}

model AccountTransaction {
  id          String   @id @default(cuid())
  accountId   String
  externalId  String?
  amount      Float
  description String
  category    String?
  subcategory String?
  date        DateTime
  type        String
  status      String   @default("posted")
  merchant    String?
  location    String?
  metadata    String?
  isReviewed  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date], map: "idx_account_transaction_account_date")
  @@index([category], map: "idx_account_transaction_category")
  @@index([merchant], map: "idx_account_transaction_merchant")
  @@index([status], map: "idx_account_transaction_status")
  @@index([isReviewed], map: "idx_account_transaction_reviewed")
  @@index([date, category], map: "idx_account_transaction_date_category")
  @@map("account_transactions")
}

model CategoryMapping {
  id              String   @id @default(cuid())
  merchantPattern String
  description     String?
  category        String
  subcategory     String?
  confidence      Float    @default(1.0)
  isUserDefined   Boolean  @default(false)
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([merchantPattern], map: "idx_category_mapping_merchant")
  @@index([category], map: "idx_category_mapping_category")
  @@index([confidence], map: "idx_category_mapping_confidence")
  @@index([usageCount], map: "idx_category_mapping_usage")
  @@map("category_mappings")
}

model Expense {
  id            String   @id @default(cuid())
  userId        String
  category      String
  subcategory   String?
  amount        Float
  description   String
  date          DateTime @default(now())
  merchant      String?
  isRecurring   Boolean  @default(false)
  frequency     String?
  paymentMethod String?
  location      String?
  receipt       String?
  tags          String?
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category], map: "idx_expense_user_category")
  @@index([userId, date], map: "idx_expense_user_date")
  @@index([merchant], map: "idx_expense_merchant")
  @@index([isRecurring], map: "idx_expense_recurring")
  @@index([userId, isRecurring], map: "idx_expense_user_recurring")
  @@index([category, date], map: "idx_expense_category_date")
  @@map("expenses")
}

model ExpenseCategory {
  id             String   @id @default(cuid())
  name           String   @unique
  displayName    String
  icon           String
  color          String
  parentCategory String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  budgetLimit    Float?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@index([isActive], map: "idx_expense_category_active")
  @@index([parentCategory], map: "idx_expense_category_parent")
  @@index([sortOrder], map: "idx_expense_category_sort")
  @@map("expense_categories")
}

model BudgetPlan {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String   @default("monthly")
  totalBudget    Float
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  categories     String
  alertThreshold Float    @default(80)
  description    String?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive], map: "idx_budget_plan_user_active")
  @@index([type], map: "idx_budget_plan_type")
  @@index([startDate, endDate], map: "idx_budget_plan_date_range")
  @@index([userId, startDate], map: "idx_budget_plan_user_start")
  @@map("budget_plans")
}

model FinancialSuggestion {
  id              String    @id @default(cuid())
  userId          String
  type            String
  title           String
  description     String
  impact          String
  category        String?
  potentialSaving Float?
  actionRequired  String
  priority        Int       @default(5)
  status          String    @default("active")
  generatedBy     String
  validUntil      DateTime?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status], map: "idx_financial_suggestion_user_status")
  @@index([userId, priority], map: "idx_financial_suggestion_user_priority")
  @@index([impact], map: "idx_financial_suggestion_impact")
  @@index([validUntil], map: "idx_financial_suggestion_valid")
  @@index([generatedBy], map: "idx_financial_suggestion_generated")
  @@map("financial_suggestions")
}

model OauthState {
  id        String   @id @default(cuid())
  state     String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([state], map: "idx_oauth_state_lookup")
  @@index([expiresAt], map: "idx_oauth_state_expires")
  @@index([createdAt], map: "idx_oauth_state_created")
  @@map("oauth_states")
}

model ScaChallenge {
  id                 String       @id @default(cuid())
  userId             String
  transactionId      String       @unique
  allowedMethods     String
  challengeData      String
  status             String       @default("pending")
  attempts           Int          @default(0)
  expiresAt          DateTime
  completedAt        DateTime?
  verificationMethod String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           ScaSession[]

  @@index([userId, status], map: "idx_sca_challenge_user_status")
  @@index([transactionId], map: "idx_sca_challenge_transaction")
  @@index([expiresAt], map: "idx_sca_challenge_expires")
  @@index([status, expiresAt], map: "idx_sca_challenge_status_expires")
  @@map("sca_challenges")
}

model ScaSession {
  id          String       @id @default(cuid())
  userId      String
  challengeId String
  status      String       @default("active")
  expiresAt   DateTime
  lastUsedAt  DateTime     @default(now())
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  challenge   ScaChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt], map: "idx_sca_session_user_active")
  @@index([challengeId], map: "idx_sca_session_challenge")
  @@index([expiresAt], map: "idx_sca_session_expires")
  @@map("sca_sessions")
}

model UserDevice {
  id          String   @id @default(cuid())
