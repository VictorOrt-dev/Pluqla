enum SubscriptionTier {
  FREE
  PREMIUM
  ENTERPRISE
}

// ============================================================================
// SMART RECIPE RECOMMENDATION SYSTEM - Phase 1A
// ============================================================================

/// User profile for recipe preferences and smart suggestions
model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  dietaryRestrictions   String?  // JSON array: ["vegetarian", "gluten-free"]
  dislikedIngredients   String?  // JSON array: ["mushrooms", "olives"]
  preferredCuisines     String?  // JSON array: ["italian", "french", "japanese"]
  maxCookingTime        Int?     // Max cooking time in minutes
  budgetPerMeal         Float?   // Average budget per meal in EUR
  foodBudgetEur         Float?   // Monthly food budget in EUR (for finance integration)
  skillLevel            String   @default("intermediate") // beginner, easy, intermediate, advanced, expert
  lastUpdated           DateTime @default(now()) @updatedAt
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_profile_user")
  @@map("user_profiles")
}

/// User interactions with recipes from external APIs (analytics)
model RecipeInteraction {
  id              String   @id @default(cuid())
  userId          String
  externalId      String   // Recipe ID from external provider
  provider        String   // 'spoonacular', 'edamam', 'themealdb'
  interactionType String   // "view", "cook", "favorite"
  ipHash          String?  // SHA256 hash of IP + salt for anti-spam
  metadata        Json?    // Additional data: { suspicious: true/false, userAgent: "..." }
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, externalId, interactionType], map: "idx_recipe_interaction_external_type")
  @@index([userId, externalId], map: "idx_recipe_interaction_user_recipe")
  @@index([createdAt], map: "idx_recipe_interaction_created")
  @@index([interactionType, createdAt], map: "idx_recipe_interaction_type_created")
  @@index([provider, externalId, createdAt], map: "idx_recipe_interaction_external_created")
  @@map("recipe_interactions")
}

/// Audit log for GDPR compliance
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // "profile_update", "data_export", "data_deletion", "suspicious_activity"
  entityType  String   // "UserProfile", "RecipeInteraction", etc.
  entityId    String?
  changes     Json?    // Before/after values for updates
  ipAddress   String?
  userAgent   String?
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now())

  @@index([userId, action], map: "idx_audit_log_user_action")
  @@index([createdAt], map: "idx_audit_log_created")
  @@index([action, createdAt], map: "idx_audit_log_action_created")
  @@map("audit_logs")
}

// ============================================================================
// MEAL PLANNING SYSTEM (Jow-inspired)
// ============================================================================

model UserMealPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  householdSize        Int      @default(2)
  dietaryRestrictions  String?  // JSON array
  dislikedIngredients  String?  // JSON array
  preferredCuisines    String?  // JSON array
  skillLevel           String   @default("intermediate")
  weeklyBudget         Float?
  cookingFrequency     String   @default("daily") // daily, 3-4times, weekends
  mealTypes            String?  // JSON array of preferred meal types
  allergies            String?  // JSON array
  cookingTimeLimit     Int?     // minutes per meal
  eatingHabits         String?  // JSON object with breakfast/lunch/dinner preferences
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlans            WeeklyMealPlan[]

  @@index([userId], map: "idx_meal_preferences_user")
  @@map("user_meal_preferences")
}

model WeeklyMealPlan {
  id               String                 @id @default(cuid())
  userId           String
  weekStartDate    DateTime
  weekEndDate      DateTime
  status           String                 @default("active") // active, archived, draft
  totalBudget      Float?
  actualCost       Float                  @default(0)
  mealsCount       Int                    @default(0)
  planHash         String                 // For deduplication
  generatedBy      String                 @default("ai") // ai, manual
  metadata         String?                // JSON
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPreferences  UserMealPreferences?   @relation(fields: [preferencesId], references: [id])
  preferencesId    String?
  meals            PlannedMeal[]
  groceryLists     GroceryList[]
  sharedPlans      SharedMealPlan[]

  @@index([userId, weekStartDate], map: "idx_weekly_plan_user_week")
  @@index([status], map: "idx_weekly_plan_status")
  @@index([userId, status], map: "idx_weekly_plan_user_status")
  @@index([planHash], map: "idx_weekly_plan_hash")
  @@map("weekly_meal_plans")
}

model PlannedMeal {
  id               String          @id @default(cuid())
  weeklyPlanId     String
  externalId       String?         // Recipe ID from external provider (if applicable)
  provider         String?         // 'spoonacular', 'edamam', 'themealdb' (if from API)
  dayOfWeek        Int             // 0=Monday, 6=Sunday
  mealType         String          // breakfast, lunch, dinner, snack
  mealName         String
  servings         Int             @default(2)
  cookingTimeMin   Int
  totalCostEur     Float
  ingredients      String          // JSON array
  recipe           String          // JSON array of steps
  nutritionInfo    String?         // JSON object
  difficulty       String          @default("intermediate")
  cuisineType      String?
  tags             String?         // JSON array
  ecoScore         Int?            // Pluqla EcoScore 0-100
  isCooked         Boolean         @default(false)
  cookedAt         DateTime?
  rating           Int?            // 1-5 stars
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  weeklyPlan       WeeklyMealPlan  @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@index([weeklyPlanId], map: "idx_planned_meal_plan")
  @@index([dayOfWeek, mealType], map: "idx_planned_meal_day_type")
  @@index([provider, externalId], map: "idx_planned_meal_external")
  @@index([weeklyPlanId, dayOfWeek], map: "idx_planned_meal_plan_day")
  @@index([isCooked], map: "idx_planned_meal_cooked")
  @@index([weeklyPlanId, isCooked], map: "idx_planned_meal_plan_cooked")
  @@map("planned_meals")
}

model GroceryList {
  id              String          @id @default(cuid())
  weeklyPlanId    String
  userId          String
  status          String          @default("pending") // pending, shopping, completed
  totalItems      Int             @default(0)
  checkedItems    Int             @default(0)
  estimatedCost   Float           @default(0)
  actualCost      Float?
  generatedAt     DateTime        @default(now())
  shoppedAt       DateTime?
  metadata        String?         // JSON
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  weeklyPlan      WeeklyMealPlan  @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           GroceryItem[]

  @@index([userId, status], map: "idx_grocery_list_user_status")
  @@index([weeklyPlanId], map: "idx_grocery_list_plan")
  @@index([status], map: "idx_grocery_list_status")
  @@map("grocery_lists")
}

model GroceryItem {
  id                String       @id @default(cuid())
  groceryListId     String
  name              String
  quantity          String
  unit              String?
  category          String       @default("other") // produce, dairy, meat, pantry, etc.
  estimatedCostEur  Float        @default(0)
  actualCostEur     Float?
  isChecked         Boolean      @default(false)
  checkedAt         DateTime?
  notes             String?
  usedInMeals       String?      // JSON array of meal IDs
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  groceryList       GroceryList  @relation(fields: [groceryListId], references: [id], onDelete: Cascade)

  @@index([groceryListId, category], map: "idx_grocery_item_list_category")
  @@index([isChecked], map: "idx_grocery_item_checked")
  @@index([category], map: "idx_grocery_item_category")
  @@map("grocery_items")
}

model FavoriteMeal {
  id               String   @id @default(cuid())
  userId           String
  mealName         String
  servings         Int      @default(2)
  cookingTimeMin   Int
  totalCostEur     Float
  ingredients      String   // JSON array
  recipe           String   // JSON array of steps
  nutritionInfo    String?  // JSON object
  difficulty       String   @default("intermediate")
  cuisineType      String?
  mealType         String   // breakfast, lunch, dinner, snack
  tags             String?  // JSON array
  notes            String?
  timesCooked      Int      @default(0)
  lastCookedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_favorite_meal_user")
  @@index([userId, mealType], map: "idx_favorite_meal_user_type")
  @@index([cuisineType], map: "idx_favorite_meal_cuisine")
  @@map("favorite_meals")
}

model MealPlanTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String?
  createdByUserId   String
  isPublic          Boolean  @default(false)
  category          String   @default("custom") // custom, quick, healthy, budget, vegetarian
  daysCount         Int      @default(7)
  mealsPerDay       Int      @default(2)
  targetBudget      Float?
  difficulty        String   @default("intermediate")
  dietaryTags       String?  // JSON array
  templateData      String   // JSON with meal structure
  usageCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([createdByUserId], map: "idx_template_creator")
  @@index([isPublic, category], map: "idx_template_public_category")
  @@index([category], map: "idx_template_category")
  @@map("meal_plan_templates")
}

model SharedMealPlan {
  id              String          @id @default(cuid())
  weeklyPlanId    String
  userId          String
  shareToken      String          @unique
  expiresAt       DateTime?
  viewCount       Int             @default(0)
  isPublic        Boolean         @default(true)
  allowCopy       Boolean         @default(true)
  createdAt       DateTime        @default(now())
  lastViewedAt    DateTime?
  weeklyPlan      WeeklyMealPlan  @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareToken], map: "idx_shared_plan_token")
  @@index([userId], map: "idx_shared_plan_user")
  @@index([weeklyPlanId], map: "idx_shared_plan_weekly")
  @@index([expiresAt], map: "idx_shared_plan_expires")
  @@map("shared_meal_plans")
}
