  @@unique([userId, deviceHash])
  @@index([userId, isActive], map: "idx_user_device_user_active")
  @@index([deviceHash], map: "idx_user_device_hash")
  @@index([lastSeenAt], map: "idx_user_device_last_seen")
  @@map("user_devices")
}

model UserLocation {
  id          String   @id @default(cuid())
  userId      String
  ipAddress   String
