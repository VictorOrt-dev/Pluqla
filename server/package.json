{
  "name": "plus-clair-backend",
  "version": "1.0.0",
  "description": "Backend API pour l'application Pluqla - Économies intelligentes avec IA",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "npm run config-check && node src/server.js",
    "build": "echo 'No build step required'",
    "test": "dotenv -e .env.test -- jest --runInBand --detectOpenHandles",
    "test:watch": "dotenv -e .env.test -- jest --watch --runInBand --detectOpenHandles",
    "test:coverage": "dotenv -e .env.test -- jest --coverage --runInBand --detectOpenHandles",
    "test:ci": "dotenv -e .env.test -- jest --ci --coverage --maxWorkers=1",
    "test:auth": "node scripts/run-auth-tests.js",
    "test:auth:quick": "node scripts/run-auth-tests.js --quick",
    "test:auth:coverage": "node scripts/run-auth-tests.js --coverage",
    "test:auth:watch": "node scripts/run-auth-tests.js --watch",
    "test:auth:integration": "dotenv -e .env.test -- jest tests/authAdmin.integration.test.js --runInBand",
    "test:cli": "dotenv -e .env.test -- jest tests/cli/auth-admin.test.js --runInBand",
    "test:integration": "dotenv -e .env.test -- jest tests/*.integration.test.js --runInBand",
    "pretest": "npm run prisma:generate",
    "config-check": "node scripts/configCheck.js",
    "prestart": "npm run config-check",
    "predeploy": "npm run config-check && npm run lint && npm test",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/",
    "docs:generate": "node scripts/generateOpenApi.js",
    "docs:serve": "npm start",
    "docker:build": "docker build -t plus-clair-backend .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "production:setup": "npm ci && npm run db:generate && npm run db:deploy && npm run config-check",
    "auth:cli": "node src/cli/auth-admin.js",
    "bench:autocannon": "node scripts/bench/autocannon-run.js",
    "bench:k6": "k6 run scripts/bench/k6-script.js",
    "bench:all": "npm run bench:autocannon && npm run bench:k6",
    "security:review": "node scripts/security/validate-env.js",
    "monitoring:up": "docker-compose -f ../infra/docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker-compose -f ../infra/docker-compose.monitoring.yml down",
    "monitoring:logs": "docker-compose -f ../infra/docker-compose.monitoring.yml logs -f"
  },
  "keywords": [
    "nodejs",
    "express",
    "prisma",
    "jwt",
    "api",
    "savings",
    "ai",
    "french"
  ],
  "author": "Victor - Pluqla Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@prisma/client": "^6.16.3",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "chalk": "^5.6.2",
    "compression": "^1.7.4",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-prom-bundle": "^8.0.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "google-auth-library": "^10.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.0.1",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "lru-cache": "^11.2.2",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "nordigen-node": "^1.4.1",
    "openai": "^4.24.0",
    "pino": "^9.12.0",
    "pino-pretty": "^13.1.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.8.2",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.32.6",
    "uuid": "^9.0.1",
    "validator": "^13.15.15",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "yargs": "^18.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.6.1",
    "autocannon": "^8.0.0",
    "better-auth": "^1.3.24",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "prisma": "^6.16.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "tests/",
      "node_modules/"
    ],
    "delay": 1000
  }
}
