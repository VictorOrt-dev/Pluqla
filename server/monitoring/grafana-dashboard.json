            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 69
        },
        "id": 25,
        "yaxes": [
          {
            "format": "deckbytes",
            "label": "Memory",
            "show": true
          }
        ]
      }
    ],
    "schemaVersion": 36,
    "style": "dark",
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "refresh": "30s"
  }
}
