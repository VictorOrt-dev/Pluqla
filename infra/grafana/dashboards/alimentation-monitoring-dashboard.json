{
  "dashboard": {
    "title": "Alimentation Feature - Phase 8 Monitoring",
    "uid": "alimentation-phase8",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "tags": ["alimentation", "phase8", "recipes", "monitoring"],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "liveNow": false,
    "panels": [
      {
        "id": 1,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "type": "graph",
        "title": "📊 Panel 1: Recipe Search Latency (p50, p95, p99)",
        "description": "Latence des recherches de recettes - Target: p95 < 500ms",
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.50, sum(rate(alimentation_recipe_search_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50 - Median",
            "interval": "",
            "exemplar": true
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum(rate(alimentation_recipe_search_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95 - Target < 500ms",
            "interval": "",
            "exemplar": true
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum(rate(alimentation_recipe_search_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99 - Max acceptable",
            "interval": "",
            "exemplar": true
          }
        ],
        "yaxes": [
          {
            "label": "Duration (seconds)",
            "format": "s",
            "show": true,
            "min": 0
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "thresholds": [
          {
            "value": 0.5,
            "colorMode": "critical",
            "op": "gt",
            "fill": true,
            "line": true
          }
        ],
        "alert": {
          "alertRuleTags": {},
          "conditions": [
            {
              "evaluator": {
                "params": [1],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["B", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "1m",
          "handler": 1,
          "message": "⚠️ ALERTE Phase 8: Recipe search p95 latency > 1s (target: <500ms)",
          "name": "Recipe Search Latency Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 2,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "type": "graph",
        "title": "🤖 Panel 2: AI Suggestion Performance",
        "description": "Performance des suggestions IA - Target: p95 < 1s",
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.50, sum(rate(alimentation_ai_suggestion_duration_seconds_bucket{type=\"smart_suggestion\"}[5m])) by (le))",
            "legendFormat": "Smart Suggestions p50"
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum(rate(alimentation_ai_suggestion_duration_seconds_bucket{type=\"smart_suggestion\"}[5m])) by (le))",
            "legendFormat": "Smart Suggestions p95"
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.50, sum(rate(alimentation_ai_suggestion_duration_seconds_bucket{type=\"weekly_plan\"}[5m])) by (le))",
            "legendFormat": "Weekly Plan p50"
          },
          {
            "refId": "D",
            "expr": "histogram_quantile(0.95, sum(rate(alimentation_ai_suggestion_duration_seconds_bucket{type=\"weekly_plan\"}[5m])) by (le))",
            "legendFormat": "Weekly Plan p95"
          }
        ],
        "yaxes": [
          {
            "label": "Duration (seconds)",
            "format": "s",
            "show": true,
            "min": 0
          }
        ],
        "thresholds": [
          {
            "value": 1,
            "colorMode": "warning",
            "op": "gt"
          }
        ]
      },
      {
        "id": 3,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "type": "graph",
        "title": "❤️ Panel 3: User Engagement - Favorites Over Time",
        "description": "Engagement utilisateur via les favoris",
        "targets": [
          {
            "refId": "A",
            "expr": "rate(alimentation_favorites_total{action=\"add\"}[5m])",
            "legendFormat": "Favorites Added ({{source}})"
          },
          {
            "refId": "B",
            "expr": "rate(alimentation_favorites_total{action=\"remove\"}[5m])",
            "legendFormat": "Favorites Removed"
          },
          {
            "refId": "C",
            "expr": "sum(rate(alimentation_favorites_total{action=\"add\"}[5m])) - sum(rate(alimentation_favorites_total{action=\"remove\"}[5m]))",
            "legendFormat": "Net Favorites Growth"
          }
        ],
        "yaxes": [
          {
            "label": "Rate (per second)",
            "format": "ops",
            "show": true,
            "min": 0
          }
        ],
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 4,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "type": "graph",
        "title": "🎯 Panel 4: Forecast Accuracy Trending",
        "description": "Précision du matching Prévu vs Réel",
        "targets": [
          {
            "refId": "A",
            "expr": "alimentation_forecast_match_accuracy{time_window=\"24h\"}",
            "legendFormat": "24h Accuracy"
          },
          {
            "refId": "B",
            "expr": "alimentation_forecast_match_accuracy{time_window=\"7d\"}",
            "legendFormat": "7d Accuracy"
          },
          {
            "refId": "C",
            "expr": "alimentation_forecast_match_accuracy{time_window=\"30d\"}",
            "legendFormat": "30d Accuracy"
          }
        ],
        "yaxes": [
          {
            "label": "Accuracy (%)",
            "format": "percent",
            "show": true,
            "min": 0,
            "max": 100
          }
        ],
        "thresholds": [
          {
            "value": 70,
            "colorMode": "custom",
            "fill": false,
            "line": true,
            "lineColor": "rgba(255, 193, 7, 0.7)"
          },
          {
            "value": 85,
            "colorMode": "custom",
            "fill": false,
            "line": true,
            "lineColor": "rgba(76, 175, 80, 0.7)"
          }
        ],
        "fill": 2,
        "linewidth": 2
      },
      {
        "id": 5,
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "type": "graph",
        "title": "🔌 Panel 5: External API Health + Error Rates",
        "description": "Santé des APIs externes (Spoonacular, Edamam, TheMealDB) - Alert si > 5%",
        "targets": [
          {
            "refId": "A",
            "expr": "alimentation_api_error_rate{provider=\"spoonacular\"}",
            "legendFormat": "Spoonacular Error Rate"
          },
          {
            "refId": "B",
            "expr": "alimentation_api_error_rate{provider=\"edamam\"}",
            "legendFormat": "Edamam Error Rate"
          },
          {
            "refId": "C",
            "expr": "alimentation_api_error_rate{provider=\"themealdb\"}",
            "legendFormat": "TheMealDB Error Rate"
          },
          {
            "refId": "D",
            "expr": "sum(rate(alimentation_recipe_search_duration_seconds_count{status=\"success\"}[5m])) by (provider)",
            "legendFormat": "{{provider}} Success Rate",
            "yAxisIndex": 1
          }
        ],
        "yaxes": [
          {
            "label": "Error Rate (%)",
            "format": "percent",
            "show": true,
            "min": 0,
            "max": 100
          },
          {
            "label": "Request Rate",
            "format": "ops",
            "show": true
          }
        ],
        "thresholds": [
          {
            "value": 5,
            "colorMode": "critical",
            "op": "gt",
            "fill": true,
            "line": true
          }
        ],
        "alert": {
          "alertRuleTags": {},
          "conditions": [
            {
              "evaluator": {
                "params": [5],
                "type": "gt"
              },
              "operator": {
                "type": "or"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            },
            {
              "evaluator": {
                "params": [5],
                "type": "gt"
              },
              "operator": {
                "type": "or"
              },
              "query": {
                "params": ["B", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            },
            {
              "evaluator": {
                "params": [5],
                "type": "gt"
              },
              "operator": {
                "type": "or"
              },
              "query": {
                "params": ["C", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "3m",
          "frequency": "1m",
          "handler": 1,
          "message": "⚠️ ALERTE Phase 8: External API error rate > 5% - Check {{provider}} health",
          "name": "External API Error Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        },
        "fill": 1,
        "linewidth": 2
      }
    ],
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "Prometheus",
            "value": "Prometheus"
          },
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "name": "datasource",
          "options": [],
          "query": "prometheus",
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "type": "datasource"
        },
        {
          "allValue": "",
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "definition": "label_values(alimentation_recipe_search_duration_seconds_bucket, provider)",
          "hide": 0,
          "includeAll": true,
          "multi": true,
          "name": "provider",
          "options": [],
          "query": {
            "query": "label_values(alimentation_recipe_search_duration_seconds_bucket, provider)",
            "refId": "StandardVariableQuery"
          },
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "sort": 0,
          "type": "query"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  },
  "overwrite": false,
  "message": "Phase 8 - Alimentation monitoring dashboard with 5 panels and 2 alerts",
  "folderId": 0,
  "folderUid": ""
}
