# E2E TEST ENVIRONMENT CONFIGURATION
# This file contains test-specific environment variables
# NEVER use production values here

# Test Database (isolated from development)
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/pluqla_test"
DATABASE_URL="postgresql://postgres:password@localhost:5432/pluqla_test"

# JWT Secrets (test-specific, never use in production)
JWT_SECRET="test_jwt_secret_for_e2e_testing_at_least_32_characters_long_secure_key"
JWT_REFRESH_SECRET="test_refresh_secret_for_e2e_testing_at_least_32_characters_long_key"
JWT_EMAIL_SECRET="test_email_secret_for_e2e_testing_at_least_32_characters_long_key"
JWT_PASSWORD_RESET_SECRET="test_reset_secret_for_e2e_testing_at_least_32_characters_long_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Test Server Configuration
PORT=3004
NODE_ENV="test"
TEST_API_URL="http://localhost:3004"

# Mock Email Service (for password reset testing)
EMAIL_HOST="mock"
EMAIL_PORT=587
EMAIL_USER="test@mock.com"
EMAIL_PASS="mockpass"
EMAIL_FROM="test@pluqla.app"

# Logging (minimal for tests)
LOG_LEVEL="error"
LOG_FILE_ENABLED=false

# Security (test values)
FINANCIAL_ENCRYPTION_KEY="test_encryption_key_32_characters_long_for_testing_only_never_production"
BCRYPT_ROUNDS=10

# Rate Limiting (relaxed for testing)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Feature Flags (testing configuration)
FEATURE_AI_EXTERNAL_API=false
FEATURE_ANALYTICS_TRACKING=false
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_CACHE_REDIS=false

# Test-specific settings
SKIP_EMAIL_VERIFICATION=false
TEST_MODE=true
MOCK_EMAIL_SERVICE=true

# CI/CD Environment Detection
CI=${CI}
GITHUB_ACTIONS=${GITHUB_ACTIONS}