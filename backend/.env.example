# Base de données
DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET="super_secret_key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# API Keys pour IA (optionnelles)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Configuration serveur
PORT=3002
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Cache Redis (optionnel, utilise SQLite par défaut)
REDIS_URL=""
CACHE_TTL_DEFAULT=600
CACHE_TTL_AI=3600

# Upload et stockage
UPLOAD_MAX_SIZE="10mb"
UPLOAD_PATH="./uploads"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# Email (pour notifications)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@plusclair.app"

# Analytics et monitoring
ANALYTICS_ENABLED=true
LOG_LEVEL="info"
LOG_FILE_ENABLED=true

# Sécurité
FINANCIAL_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-change-in-production"
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TIMEOUT_MS=1800000

# OAuth Configuration (pour intégration bancaire)
BRIDGE_CLIENT_ID=""
BRIDGE_CLIENT_SECRET=""
BUDGET_INSIGHT_CLIENT_ID=""
BUDGET_INSIGHT_CLIENT_SECRET=""
TINK_CLIENT_ID=""
TINK_CLIENT_SECRET=""

# Feature Flags
FEATURE_AI_EXTERNAL_API=false
FEATURE_ANALYTICS_TRACKING=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_CACHE_REDIS=false
FEATURE_OAUTH_INTEGRATION=false

# Déploiement (Production)
WEBHOOK_SECRET=""
DATABASE_POOL_SIZE=20
TRUST_PROXY=true