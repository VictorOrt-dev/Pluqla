# Test Environment Variables
NODE_ENV=test
DATABASE_URL=postgresql://pluqla:pluqla@localhost:5432/pluqla_test?schema=public
PORT=3005

# Better Auth Configuration
BETTER_AUTH_SECRET=test_better_auth_secret_32_chars_minimum_for_testing_env
BASE_URL="http://localhost:3005"

# JWT Secrets for testing
JWT_SECRET="test_jwt_secret_32_chars_minimum_for_unit_tests_8888888888"
JWT_REFRESH_SECRET="test_refresh_secret_32_chars_minimum_for_testing_888888888"
JWT_EMAIL_SECRET="test_email_secret_32_chars_minimum_for_testing_8888888888"
JWT_PASSWORD_RESET_SECRET="test_password_reset_secret_32_chars_minimum_for_testing_88"

# Security Keys (test values)
FINANCIAL_ENCRYPTION_KEY="test_financial_key_32_chars_minimum_for_tests_88888888888"
BANK_ENCRYPTION_KEY="test_bank_key_32_chars_minimum_for_tests_888888888888888"
SESSION_SECRET="test_session_secret_32_chars_min_8888888888888888888888888"

# AI Configuration (mock mode for testing)
AI_PROVIDER=mock
OPENAI_API_KEY=test_dummy_key_for_mock_mode
AI_ANONYMIZATION_SALT="test-ai-anonymization-salt-2024"

# Redis Configuration (separate DB for tests)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_QUEUE_DB=3

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY=false

# Rate Limiting (very lenient for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10000

# Logging (quiet for tests)
LOG_LEVEL=error
EMAIL_ENABLED=false
REDIS_URL=""
DEBUG_SQL=false
