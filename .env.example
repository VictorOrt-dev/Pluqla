# 🚀 PLUQLA CLIENT CONFIGURATION
# Copy this file to .env and fill in your actual values

# ===== API CONFIGURATION =====
# Backend API URL - adjust port to match your server configuration
REACT_APP_API_URL=http://localhost:3004/api

# ===== ENVIRONMENT =====
REACT_APP_ENVIRONMENT=development

# ===== APPLICATION INFO =====
REACT_APP_VERSION=2.0.0
REACT_APP_APP_NAME=Pluqla

# ===== PWA CONFIGURATION =====
REACT_APP_ENABLE_PWA=true
REACT_APP_PWA_UPDATE_AVAILABLE=true

# ===== ANALYTICS & MONITORING =====
# Google Analytics (optional)
REACT_APP_GOOGLE_ANALYTICS_ID=
# Sentry for error monitoring (optional)
REACT_APP_SENTRY_DSN=
# Hotjar for user analytics (optional)
REACT_APP_HOTJAR_ID=

# ===== FEATURE FLAGS =====
REACT_APP_ENABLE_EXPERIMENTAL_FEATURES=false
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_FINANCIAL_FEATURES=true
REACT_APP_ENABLE_GAMIFICATION=true

# ===== DEVELOPMENT & DEBUG =====
REACT_APP_DEBUG_MODE=false
REACT_APP_MOCK_API=false
REACT_APP_ENABLE_DEVTOOLS=false

# ===== AI SERVICES (CLIENT-SIDE KEYS) =====
# Note: Be careful with client-side API keys - consider using backend proxy
REACT_APP_OPENAI_API_KEY=
REACT_APP_ANTHROPIC_API_KEY=

# ===== MAPS & GEOLOCATION =====
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_MAPBOX_TOKEN=

# ===== SOCIAL AUTH (CLIENT IDs) =====
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_FACEBOOK_APP_ID=
REACT_APP_GITHUB_CLIENT_ID=

# ===== PAYMENT SERVICES =====
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_PAYPAL_CLIENT_ID=

# ===== BUILD CONFIGURATION =====
# Set to 'true' to enable source maps in production (not recommended)
GENERATE_SOURCEMAP=false